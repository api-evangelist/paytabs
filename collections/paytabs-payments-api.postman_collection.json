          "name": "Create or act on a transaction",
          "request": {
            "name": "Create or act on a transaction",
            "description": {
              "content": "Creates a transaction. The `tran_type` field selects the action - `sale` or `auth` initiate a new payment (returning a hosted `redirect_url` for HPP/managed/own-form flows, or authorizing a stored `token`), while `capture`, `void`, `release`, `refund` and `register` act on a prior transaction referenced by `tran_ref`. Invoice and recurring flows reuse the same endpoint with additional fields.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "payment",
                "request"
              ],
              "host": [
                "{{baseUrl}}"
              ],
